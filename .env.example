# Local Postgres (optional). Leave unset to use the built-in PGLite shop book.
# DATABASE_URL=postgres://user:pass@localhost:5432/skyline_qx

# Auth — leave unset for local preview (Google / X via Grok broker).
# Set VITE_AUTH_ENABLED=false to skip sign-in and use a local estimator.
# VITE_AUTH_ENABLED=true
# BETTER_AUTH_URL=http://localhost:8080
# BETTER_AUTH_SECRET=
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# AI takeoff (optional). Uses xAI when present.
# XAI_API_KEY=
